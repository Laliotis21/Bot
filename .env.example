# ─────────────────────────────────────────────────────────────────────────
#  Trading Bot — Παράδειγμα ρυθμίσεων
#  Αντίγραψέ το σε αρχείο .env:   cp .env.example .env
#  και συμπλήρωσε τα API keys. ΠΟΤΕ μην κάνεις commit το πραγματικό .env!
# ─────────────────────────────────────────────────────────────────────────

# --- Exchange & περιβάλλον ---
EXCHANGE=binance
# true = testnet (paper trading, χωρίς ρίσκο) | false = LIVE με αληθινά χρήματα
USE_TESTNET=true

# --- API keys (από testnet.binancefuture.com για το Binance Futures Testnet) ---
API_KEY=
API_SECRET=

# --- Στρατηγική ---
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1d
EMA_FAST=9
EMA_SLOW=21

# --- Διαχείριση ρίσκου ---
LEVERAGE=1
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15

# Ποσοστό του διαθέσιμου κεφαλαίου ανά trade (compounding).
# 1.0 = 100% (σύμφωνα με το spec). Default 0.95 ώστε να μένει buffer για fees
# και να αποφεύγονται απορρίψεις "insufficient margin".
POSITION_SIZE_PCT=0.95

# --- Συχνότητα βρόχου (δευτερόλεπτα). Daily timeframe -> δεν χρειάζεται per-second. ---
LOOP_INTERVAL=60

# --- TSMOM bot (12μηνο momentum, long-or-flat, tsmom_bot.py) ---
# ΠΡΟΣΟΧΗ: μην μοιράζεσαι σύμβολα με το EMA bot στον ίδιο λογαριασμό.
TSMOM_SYMBOLS=BTC/USDT,ETH/USDT
TSMOM_LOOKBACK_MONTHS=12
TSMOM_ALLOCATION_PCT=0.5
TSMOM_CHECK_INTERVAL=21600

# --- Funding harvester (delta-neutral, funding_bot.py) ---
# PAPER mode default: πραγματικά rates/αποφάσεις, λογιστικό εισόδημα.
# FUNDING_EXECUTE=true μόνο σε λογαριασμό χωρίς αντικρουόμενες θέσεις.
FUNDING_SYMBOLS=BTC/USDT,ETH/USDT
FUNDING_ALLOCATION_PCT=0.3
FUNDING_ENTER_APR=0.05
FUNDING_EXIT_APR=0.0
FUNDING_CHECK_INTERVAL=3600
FUNDING_EXECUTE=false
