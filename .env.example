# ─────────────────────────────────────────────────────────────────────────
#  Trading Bot — Παράδειγμα ρυθμίσεων
#  Αντίγραψέ το σε αρχείο .env:   cp .env.example .env
#  και συμπλήρωσε τα API keys. ΠΟΤΕ μην κάνεις commit το πραγματικό .env!
# ─────────────────────────────────────────────────────────────────────────

# --- Exchange & περιβάλλον ---
EXCHANGE=binance
# true = testnet (paper trading, χωρίς ρίσκο) | false = LIVE με αληθινά χρήματα
USE_TESTNET=true

# --- API keys (από testnet.binancefuture.com για το Binance Futures Testnet) ---
API_KEY=
API_SECRET=

# --- Στρατηγική ---
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1d
EMA_FAST=9
EMA_SLOW=21

# --- Διαχείριση ρίσκου ---
LEVERAGE=1
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15

# Ποσοστό του διαθέσιμου κεφαλαίου ανά trade (compounding).
# 1.0 = 100% (σύμφωνα με το spec). Default 0.95 ώστε να μένει buffer για fees
# και να αποφεύγονται απορρίψεις "insufficient margin".
POSITION_SIZE_PCT=0.95

# --- Συχνότητα βρόχου (δευτερόλεπτα). Daily timeframe -> δεν χρειάζεται per-second. ---
LOOP_INTERVAL=60

# --- TSMOM bot (12μηνο momentum, long-or-flat, tsmom_bot.py) ---
# ΠΡΟΣΟΧΗ: μην μοιράζεσαι σύμβολα με το EMA bot στον ίδιο λογαριασμό.
TSMOM_SYMBOLS=BTC/USDT,ETH/USDT
TSMOM_LOOKBACK_MONTHS=12
TSMOM_ALLOCATION_PCT=0.5
TSMOM_CHECK_INTERVAL=21600

# --- Funding harvester (delta-neutral, funding_bot.py) ---
# PAPER mode default: πραγματικά rates/αποφάσεις, λογιστικό εισόδημα.
# FUNDING_EXECUTE=true μόνο σε λογαριασμό χωρίς αντικρουόμενες θέσεις.
FUNDING_SYMBOLS=BTC/USDT,ETH/USDT
FUNDING_ALLOCATION_PCT=0.3
FUNDING_ENTER_APR=0.05
FUNDING_EXIT_APR=0.0
FUNDING_CHECK_INTERVAL=3600
FUNDING_EXECUTE=false

# =============================================================================
# Spot framework (app/) — modular production trading system
# Default is PAPER trading. Never enable live without explicit confirmation.
# Strongly recommend: disable withdrawal permissions on trading API keys.
# =============================================================================

# --- Capital & risk ---
INITIAL_CAPITAL=500
RISK_PER_TRADE=0.015
TARGET_RR=2.0
TARGET_WIN_RATE=0.55
MAX_DRAWDOWN=0.15
MAX_DAILY_LOSS=0.04
MAX_PORTFOLIO_EXPOSURE=1.0
MAX_OPEN_POSITIONS=3
MAX_POSITION_SIZE=1.0
MAX_CONSECUTIVE_LOSSES=5
MAX_TRADES_PER_DAY=20
EMERGENCY_CLOSE_ON_DRAWDOWN=true

# --- Fees & slippage ---
MAKER_FEE=0.00075
TAKER_FEE=0.00075
BNB_DISCOUNT=0.0
SLIPPAGE_BPS=5

# --- Spot exchange (separate keys from futures bots above) ---
# EXCHANGE already set above; spot adapter also accepts binanceus
CURRENCY=USDT
SYMBOL=BTC/USDT
# TIMEFRAME already set above for futures; override for spot CLI as needed
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# --- Modes (ALWAYS default to paper) ---
PAPER_TRADING=true
# Required only when PAPER_TRADING=false:
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_THE_RISK

# --- EMA + RSI strategy (spot framework) ---
# EMA_FAST / EMA_SLOW already set for futures; spot defaults in code are 20/50
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# --- Monte Carlo ---
MC_SIMULATIONS=1000
MC_TRADES_PER_SIM=500
RANDOM_SEED=42
RUIN_THRESHOLD=0.5

# --- Persistence ---
DATABASE_URL=sqlite:///data/trading.db
REPORTS_DIR=reports
LOGS_DIR=logs
LOG_LEVEL=INFO
STALE_DATA_SECONDS=120
API_ERROR_THRESHOLD=5
COST_BASIS_METHOD=fifo
